# The endpoint renderer emits no trunk from this disabled-only input.
DIALER_TRUNK_ENABLED=false
# Enabling requires exact assigned targets that match the network /32 pair:
# DIALER_TRUNK_SIP_URI_PRIMARY=sip:account@PRIMARY_SBC_IPV4:5060
# DIALER_TRUNK_SIP_URI_SECONDARY=sip:account@SECONDARY_SBC_IPV4:5060
# DIALER_TRUNK_AUTH_MODE=ip
# Digest mode additionally requires username, password, and realm values.
